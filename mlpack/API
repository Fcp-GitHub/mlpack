> Abstract Base Class that gives the basic traits for all 
> the models of the class. It should provide just enough to 
> group everything up here and give common basic 
> functionalities

Model(ABC):
    self.
        warnings_on
        labels
        num_classes

    __init__(warnings_on)

    _check_samples(X) -> None
    _check_targets(y) -> None

    _is_vector(X) -> bool
    _get_num_samples(X) -> int
    _get_num_features(X) -> int
    _get_num_classes(y) -> int

    _get_one_hot(y) -> ndarray(num_samples)
    
    __str__() = 0
    __repr__() = 0


